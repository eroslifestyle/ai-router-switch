# litellm.env
# Copiare come litellm.env accanto al docker-compose.yml
# Non versionare mai il file compilato
# Il compose NON parte se il file manca

# Generare un valore casuale con: openssl rand -hex 32
# Inserire lo stesso valore come LOCAL_LLM_API_KEY nel file .env del router
LITELLM_MASTER_KEY=

# Utente, password e nome del database devono combaciare con le tre variabili POSTGRES_ qui sotto
# "db" è il nome del servizio sulla rete interna del compose
DATABASE_URL=postgresql://litellm:litellm@db:5432/litellm

# Valori di esempio, da cambiare in produzione
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm
POSTGRES_DB=litellm

STORE_MODEL_IN_DB=True
