[Unit]
Description=AI Router Proxy (porta 8787) — switcher fra le nove modalità, HARDENED
Documentation=https://github.com/eroslifestyle/ai-router-switch
After=network-online.target
Wants=network-online.target
# Permetti restart frequenti senza rate-limit
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@/src
Environment=AIROUTER_PORT=8787
Environment=AIROUTER_LISTEN_HOST=127.0.0.1
Environment=AIROUTER_ANTHROPIC_UPSTREAM=https://api.anthropic.com
# Il router NON sceglie il modello: la gerarchia sta nella configurazione del
# client, il router riscrive solo il backend in base alla modalità attiva.
Environment=AIROUTER_MINIMAX_UPSTREAM=https://api.minimaxi.chat/anthropic
Environment=AIROUTER_MINIMAX_MODEL=MiniMax-M2.7
Environment=AIROUTER_NEW_PIPELINE=1
# Le chiavi API si leggono da qui. Il trattino iniziale rende ogni file
# facoltativo: senza, il servizio non partirebbe finché non esiste.
# PYTHONPATH lo imposta il wrapper, non Environment=, che troncherebbe i path
# contenenti spazi.
# I due file sotto ~/.secrets sono quelli realmente in uso in produzione: un
# template che caricava solo @CONFIG_HOME@/.env faceva ripartire il router
# SENZA chiavi API dopo una rigenerazione con install.py (2026-08-09). Restano
# facoltativi, quindi un'installazione pulita che usa solo .env funziona uguale.
EnvironmentFile=-@CONFIG_HOME@/.env
EnvironmentFile=-%h/.secrets/minimax.env
EnvironmentFile=-%h/.secrets/glm.env

# Pre-start: libera le porte da eventuali processi orfani di un restart fallito.
# Il trattino iniziale e il "|| true" rendono il passo innocuo dove fuser non c'è.
#
# NIENTE variabili di shell in questa riga. systemd espande $p PRIMA di passare
# il comando a /bin/sh e, non essendo nell'ambiente del servizio, lo sostituisce
# con la stringa vuota: il vecchio `for p in @PORTS@; do fuser -k -n tcp $p; done`
# eseguiva `fuser -k -n tcp` senza porte ("No process specification given"), non
# uccideva NULLA e il passo sembrava riuscito. Risultato: un proxy orfano teneva
# la 8787, il nuovo moriva con "errno 98 ... FATAL: uscita per bind fallito sulla
# porta principale", e con Restart=always si arrivava a StartLimitBurst — unit in
# stato failed, router mai avviato. fuser accetta piu' porte in un colpo solo,
# quindi il ciclo non serve.
ExecStartPre=-/bin/sh -c "fuser -k -n tcp @PORTS@ 2>/dev/null || true; sleep 1"

ExecStart=@WRAPPER@

# Stop: SIGTERM → 3s → SIGKILL (il proxy si blocca, non aspettare 90s default)
KillMode=mixed
KillSignal=SIGTERM
# 20 s e non 8 (2026-08-08, audit F1): il proxy creava gli AppRunner SENZA
# shutdown_timeout, quindi ogni runner ereditava il default aiohttp di 60 s e il
# cleanup era per giunta sequenziale sulle dieci porte — tetto teorico 600 s,
# SIGKILL certo ("State 'stop-sigterm' timed out. Killing", "status=9/KILL").
# Ora il proxy passa SHUTDOWN_TIMEOUT_S=3 s per runner e fa il cleanup in
# parallelo con asyncio.gather: il drain reale sta sotto i 4 s. I 20 s sono il
# margine, non il tempo atteso. Rif. sviluppo/audit/2026-08-08-stress-router/.
TimeoutStopSec=20
SendSIGKILL=yes
FinalKillSignal=SIGKILL

# Resilience
Restart=always
RestartSec=2

# Resource limits per stream SSE multipli
LimitNOFILE=65536
TasksMax=512
MemoryHigh=512M
MemoryMax=1G

# OOM safety
OOMScoreAdjust=-900
OOMPolicy=continue

[Install]
WantedBy=default.target
