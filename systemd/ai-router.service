[Unit]
Description=AI Router Proxy (porta 8787) switcher anthropic/minimax/mix-am/mix-ag/mix-gm/glm — HARDENED
Documentation=file:///home/mrxxx/Obsidian/Memoria
After=network-online.target
Wants=network-online.target
# Permetti restart frequenti senza rate-limit
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
WorkingDirectory=/mnt/backup/Dropbox/1 Programmazione/Progetti/ai-router-switch/src
Environment=AIROUTER_PORT=8787
Environment=AIROUTER_LISTEN_HOST=127.0.0.1
Environment=AIROUTER_ANTHROPIC_UPSTREAM=https://api.anthropic.com
# RIMOSSA 2026-07-26: AIROUTER_VERIFY_MODEL=claude-sonnet-4-6 era orfana (nessun
# lettore nel codice; residuo della pipeline interactive-T2 morta il 2026-07-25) e
# imponeva un modello vecchio. Il router NON sceglie il modello Anthropic: la
# gerarchia e' la config globale, il THINK lo decide l'utente da /model
# (rif. src/router_constants.py:20). Rollback: ai-router.service.bak-20260726
Environment=AIROUTER_MINIMAX_UPSTREAM=https://api.minimaxi.chat/anthropic
Environment=AIROUTER_MINIMAX_MODEL=MiniMax-M2.7
Environment=AIROUTER_NEW_PIPELINE=1
# fail_tracker.py vive nella dir parent (ai-router-switch/), non in src/
# (path con spazi: impostato via wrapper, non Environment= che troncerebbe)
EnvironmentFile=%h/.secrets/minimax.env
EnvironmentFile=%h/.secrets/glm.env

# Pre-start: libera tutte le porte da processi orfani (se restart precedente è fallito a chiudere)
ExecStartPre=-/bin/sh -c "for p in 8787 8771 8772 8773 8775 8776 8777; do fuser -k -n tcp $p 2>/dev/null || true; done; sleep 1"

ExecStart=/home/mrxxx/.claude/scripts/ai-router-proxy-wrapper.sh

# Stop: SIGTERM → 3s → SIGKILL (il proxy si blocca, non aspettare 90s default)
KillMode=mixed
KillSignal=SIGTERM
# 8 s e non 3 (2026-07-26): lo stop tipico dura ~0,04 s misurati — il drain di
# aiohttp (r.cleanup()) è già istantaneo senza stream aperti, quindi il timeout
# morde SOLO quando c'è un SSE in corso, cioè esattamente quando il SIGKILL
# tronca una risposta a metà. 8 s dà respiro a quegli stream senza bloccare i
# restart per minuti. SendSIGKILL resta la rete di sicurezza.
TimeoutStopSec=8
SendSIGKILL=yes
FinalKillSignal=SIGKILL

# Resilience
Restart=always
RestartSec=2

# Resource limits per stream SSE multipli
LimitNOFILE=65536
TasksMax=512
MemoryHigh=512M
MemoryMax=1G

# OOM safety
OOMScoreAdjust=-900
OOMPolicy=continue

[Install]
WantedBy=default.target
