{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {"type": "command", "command": "python3 .claude/hooks/enforce_agent_model.py"}
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python3 .claude/hooks/enforce_delegate_write.py"}
        ]
      }
    ]
  }
}
