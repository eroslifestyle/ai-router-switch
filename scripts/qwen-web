#!/usr/bin/env python3
"""
qwen-web - Ricerca web tramite Alibaba Cloud Model Studio (gemello di m3-web per Qwen)
Stampa su stdout il digest della risposta e l'elenco delle fonti.
Messaggi diagnostici su stderr.
"""

import os
import sys
import json
import time
import argparse
import subprocess
from datetime import datetime, timezone
from urllib.request import Request, urlopen
from urllib.error import URLError, HTTPError


def _get_api_key() -> str | None:
    """Recupera la API key da env o secrets.sh."""
    for env_var in ("QWEN_API_KEY", "DASHSCOPE_API_KEY"):
        key = os.environ.get(env_var)
        if key:
            return key
    secrets_path = os.path.expanduser("~/.claude/secrets/secrets.sh")
    try:
        result = subprocess.run(
            ["bash", secrets_path, "get", "qwen.api_key"],
            capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        pass
    return None


def _get_workspace_id() -> str | None:
    """Recupera il workspace ID da env o secrets.sh."""
    for env_var in ("QWEN_WORKSPACE_ID",):
        wid = os.environ.get(env_var)
        if wid:
            return wid
    secrets_path = os.path.expanduser("~/.claude/secrets/secrets.sh")
    try:
        result = subprocess.run(
            ["bash", secrets_path, "get", "qwen.workspace_id"],
            capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        pass
    return None


def _build_base_url() -> str:
    """Costruisce l'URL base per Model Studio."""
    ws = os.environ.get("QWEN_WORKSPACE_ID")
    region = os.environ.get("QWEN_REGION", "ap-southeast-1")
    if ws:
        return f"https://{ws}.{region}.maas.aliyuncs.com/compatible-mode/v1"
    return "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"


def _extract_sources(data: dict) -> list[dict]:
    """
    Estrae le fonti dalla risposta JSON in modo difensivo.
    Prova piu' percorsi e restituisce lista deduplicata per url.
    """
    seen_urls = set()
    sources = []

    # Percorso 1: annotations nel message
    try:
        annotations = data["choices"][0]["message"].get("annotations", [])
        for ann in annotations:
            if not isinstance(ann, dict):
                continue
            url = ann.get("url") or ann.get("link")
            title = ann.get("title") or ann.get("text", "")
            if url and url not in seen_urls:
                seen_urls.add(url)
                sources.append({"title": str(title) if title else "", "url": url})
    except (KeyError, TypeError):
        pass

    # Percorso 2: search_info.search_results
    try:
        search_results = data.get("search_info", {}).get("search_results", [])
        for sr in search_results:
            if not isinstance(sr, dict):
                continue
            url = sr.get("url") or sr.get("link")
            title = sr.get("title") or ""
            if url and url not in seen_urls:
                seen_urls.add(url)
                sources.append({"title": str(title), "url": url})
    except (KeyError, TypeError):
        pass

    # Percorso 3: message.search_results
    try:
        search_results = data["choices"][0]["message"].get("search_results", [])
        for sr in search_results:
            if not isinstance(sr, dict):
                continue
            url = sr.get("url") or sr.get("link")
            title = sr.get("title") or ""
            if url and url not in seen_urls:
                seen_urls.add(url)
                sources.append({"title": str(title), "url": url})
    except (KeyError, TypeError):
        pass

    return sources


def _telemetry_record(model: str, prompt_tokens: int, completion_tokens: int,
                       sources_count: int, elapsed: float) -> None:
    """Registra telemetria best-effort su usage.jsonl."""
    telemetry_path = os.path.expanduser("~/.claude/m3/usage.jsonl")
    record = {
        "ts": datetime.now(timezone.utc).isoformat(),
        "tool": "qwen-web",
        "model": model,
        "prompt_tokens": prompt_tokens,
        "completion_tokens": completion_tokens,
        "sources": sources_count,
        "elapsed_s": round(elapsed, 2)
    }
    try:
        os.makedirs(os.path.dirname(telemetry_path), exist_ok=True)
        with open(telemetry_path, "a") as f:
            f.write(json.dumps(record) + "\n")
    except OSError:
        pass


def _read_query_from_stdin() -> str | None:
    """Legge query da stdin, restituisce None se vuoto."""
    if not sys.stdin.isatty():
        return sys.stdin.read().strip()
    return None


def _main() -> None:
    parser = argparse.ArgumentParser(description="qwen-web - Ricerca web via Qwen Model Studio")
    parser.add_argument("query", nargs="*", help="Query di ricerca")
    parser.add_argument("-f", "--file", help="Leggi query da file")
    parser.add_argument("--model", default=os.environ.get("QWEN_WEB_MODEL", "qwen3.7-plus"),
                        help="Modello da usare (default: qwen3.7-plus)")
    parser.add_argument("--strategy", default="agent",
                        choices=["agent", "agent_max"],
                        help="Strategia di ricerca (default: agent)")
    parser.add_argument("--sources-only", action="store_true",
                        help="Stampa solo l'elenco delle fonti")
    parser.add_argument("--json", action="store_true",
                        help="Stampa la risposta JSON grezza")
    parser.add_argument("--max", type=int, default=2048,
                        help="max_tokens (default: 2048, 0 = nessun limite)")
    parser.add_argument("--timeout", type=int, default=180,
                        help="Timeout in secondi (default: 180)")

    args = parser.parse_args()

    # Leggi query
    query = None
    if args.file:
        try:
            with open(args.file) as f:
                query = f.read().strip()
        except OSError as e:
            print(f"[qwen-web] Errore lettura file {args.file}: {e}", file=sys.stderr)
            sys.exit(1)
    elif args.query:
        query = " ".join(args.query)
    else:
        query = _read_query_from_stdin()
        if query is None:
            print("[qwen-web] Query mancante: specificare argomenti, -f, o stdin", file=sys.stderr)
            sys.exit(1)

    if query == "":
        print("[qwen-web] Query vuota", file=sys.stderr)
        sys.exit(1)

    # Recupera credenziali
    api_key = _get_api_key()
    if not api_key:
        print("[qwen-web] ERRORE: API key non trovata (QWEN_API_KEY, DASHSCOPE_API_KEY, secrets.sh)",
              file=sys.stderr)
        sys.exit(2)

    base_url = _build_base_url()
    # base_url finisce con /compatible-mode/v1: per DashScope nativo serve la
    # radice del workspace.
    radice = base_url.split("/compatible-mode")[0].rstrip("/")
    endpoint = f"{radice}/api/v1/services/aigc/multimodal-generation/generation"

    # Misurato dal vivo il 2026-08-03: su /compatible-mode/v1/chat/completions
    # con enable_search le fonti NON tornano mai nello stream (277 eventi
    # ispezionati, zero occorrenze). Sul path DashScope nativo invece le fonti
    # ci sono: stessa domanda, 25 risultati con titolo e URL in
    # output.search_info.search_results. Il non-streaming e' precluso:
    # l'upstream risponde 400 'Non-streaming mode does not support Web Search
    # in thinking mode'.
    payload = {
        "model": args.model,
        "input": {"messages": [{"role": "user", "content": [{"text": query}]}]},
        "parameters": {
            "enable_search": True,
            "search_options": {
                "search_strategy": args.strategy,
                "enable_source": True,
            },
        },
    }
    if args.max > 0:
        payload["parameters"]["max_tokens"] = args.max

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
        "X-DashScope-SSE": "enable",
    }

    start = time.time()
    pezzi = []
    fonti_grezze = []
    usage_finale = {}
    modello_visto = args.model
    try:
        req = Request(endpoint, data=json.dumps(payload).encode(), headers=headers, method="POST")
        with urlopen(req, timeout=args.timeout) as resp:
            for riga in resp:
                s = riga.decode("utf-8", "replace").strip()
                if not s.startswith("data:"):
                    continue
                p = s[5:].strip()
                if p in ("", "[DONE]"):
                    continue
                try:
                    ev = json.loads(p)
                except json.JSONDecodeError:
                    continue
                if ev.get("usage"):
                    usage_finale = ev["usage"]
                out = ev.get("output") or {}
                ricerca = (out.get("search_info") or {}).get("search_results")
                if ricerca:
                    fonti_grezze = ricerca
                # i frammenti di testo sono INCREMENTALI: vanno concatenati
                for ch in out.get("choices") or []:
                    for blocco in (ch.get("message") or {}).get("content") or []:
                        if blocco.get("text"):
                            pezzi.append(blocco["text"])
    except HTTPError as e:
        body_err = e.read().decode(errors="replace")[:500]
        print(f"[qwen-web] HTTP {e.code}: {body_err}", file=sys.stderr)
        sys.exit(1)
    except URLError as e:
        print(f"[qwen-web] Errore rete: {e.reason}", file=sys.stderr)
        sys.exit(1)

    # Si ricompone la forma che il resto dello script gia' sa leggere.
    data = {
        "model": modello_visto,
        "usage": usage_finale,
        "choices": [{"message": {"content": "".join(pezzi),
                                  "search_results": fonti_grezze}}],
    }
    elapsed = time.time() - start

    # Estrai info token
    usage = data.get("usage", {})
    prompt_tokens = usage.get("prompt_tokens", 0)
    completion_tokens = usage.get("completion_tokens", 0)
    model = data.get("model", args.model)

    # Estrai fonti
    sources = _extract_sources(data)

    # Output
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
        return

    content = data["choices"][0]["message"]["content"]

    if args.sources_only:
        for s in sources:
            print(f"{s['url']}")
    else:
        print(content)
        if sources:
            print()
            print("Fonti:")
            for s in sources:
                if s["title"]:
                    print(f"  - {s['url']} ({s['title']})")
                else:
                    print(f"  - {s['url']}")

    # Riga finale stderr
    print(f"[qwen-web] {model} · {len(sources)} fonti · {elapsed:.1f}s", file=sys.stderr)

    # Telemetria
    _telemetry_record(model, prompt_tokens, completion_tokens, len(sources), elapsed)


if __name__ == "__main__":
    _main()
