# ============================================================
# File di configurazione per ai-router-switch
# Copia questo file in: $AIROUTER_HOME/.env
#   oppure ~/.claude/.env se esiste, altrimenti:
#   - Linux: ~/.config/ai-router-switch/.env
#   - macOS: ~/Library/Application Support/ai-router-switch/.env
#   - Windows: %APPDATA%\ai-router-switch\.env
# NON commettere mai questo file nel controllo di versione!
# Ogni riga è nella forma CHIAVE=valore
# ============================================================

# ------------------------------------------------------------
# CHIAVI API
# ------------------------------------------------------------
# Nota: non è necessaria alcuna chiave per Anthropic/Claude Code,
# che gestisce il token OAuth tramite .credentials.json o Keychain.
# Le chiavi qui sotto vanno compilate solo per le modalità che
# intendi usare. Mai inserire chiavi vere nei file versionati!

# Modalità minimax, mix-am, mix-gm
# Ottieni la chiave da: https://platform.minimax.io
MINIMAX_API_KEY=

# Modalità glm, mix-ag, mix-gm
# Ottieni la chiave da: https://z.ai
# Alias accettato: ZAI_API_KEY
GLM_API_KEY=

# Modalità qwen
# Ottieni la chiave da: Alibaba Model Studio
# Alias accettato: DASHSCOPE_API_KEY
QWEN_API_KEY=

# Identificatore workspace Qwen (formato: ws-xxxxxxxx)
QWEN_WORKSPACE_ID=

# Modalità local e mix-al - endpoint OpenAI-compatibile locale
# Valore predefinito di API_BASE: http://127.0.0.1:4000
LOCAL_LLM_API_KEY=
LOCAL_LLM_API_BASE=

# ------------------------------------------------------------
# RETE
# ------------------------------------------------------------
#AIROUTER_PORT=8787
#AIROUTER_LISTEN_HOST=127.0.0.1

# ------------------------------------------------------------
# UPSTREAM
# ------------------------------------------------------------
#AIROUTER_ANTHROPIC_UPSTREAM=https://api.anthropic.com
#AIROUTER_MINIMAX_UPSTREAM=https://api.minimaxi.chat/anthropic
# Queste due non hanno il prefisso AIROUTER_: i nomi letti dal codice sono
# GLM_UPSTREAM (src/glm_backend.py) e QWEN_DASHSCOPE_HOST (src/qwen_backend.py).
#GLM_UPSTREAM=https://api.z.ai/api/anthropic
#QWEN_DASHSCOPE_HOST=https://dashscope-intl.aliyuncs.com

# ------------------------------------------------------------
# LIMITI E TARATURE
# ------------------------------------------------------------
# Limite in BYTE per il contesto della richiesta (non in token)
#AIROUTER_MINIMAX_CONTEXT_LIMIT=750000

# Tetto di lettura per le risposte non-streaming
#AIROUTER_NON_STREAM_SOCK_READ_SEC=600

# Richieste concorrenti massime per provider
#AIROUTER_MINIMAX_SEMAPHORE=8
#AIROUTER_GLM_SEMAPHORE=8
#AIROUTER_QWEN_SEMAPHORE=8

# Directory di stato temporanea; se assente si usa quella di sistema
#AIROUTER_TRIM_DIR=

# ------------------------------------------------------------
# DIAGNOSTICA
# ------------------------------------------------------------
#AIROUTER_DEEP_DEBUG=0
#AIROUTER_TOOLS_TELEMETRY=0

# ------------------------------------------------------------
# Per l'elenco completo delle variabili disponibili consulta:
# docs/MANUAL.md
# ------------------------------------------------------------
